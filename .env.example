# CarePath Root Environment Variables for Docker Compose
# Copy this to .env and fill in your values

# --- Network & Domains (Cloudflare Tunnels) ---
FRONTEND_URL=https://care-path.vilohit.dev
NEXT_PUBLIC_API_URL=https://care-path-api.vilohit.dev

# --- Backend API Keys ---
GEMINI_API_KEY=your_gemini_key_here
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Frontend Auth Keys (Copied from Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
